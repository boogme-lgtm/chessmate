# Example names, never real credentials. Use a host's supported secret manager.
# Legacy hosting reference only. For isolated preview use .env.preview.example
# and docs/astra-isolated-preview-1-handoff.md instead.
NODE_ENV=production
PORT=3000
VITE_APP_ID=boogme
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=mysql://boogme:replace-me@127.0.0.1:3306/boogme_isolated
VITE_FRONTEND_URL=https://preview.example.com

# Every new preview/replica keeps all background jobs off until explicitly owned.
BACKGROUND_JOBS_ENABLED=false
AUTO_RELEASE_PAYOUTS_ENABLED=false
MANUS_DEV_TOOLS_ENABLED=false

# Stripe API authentication and destination signing are three different values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Existing direct email integration. No email tests should use a real key by default.
RESEND_API_KEY=
ADMIN_EMAIL=
VALIDATE_RESEND_CONNECTION=false
VALIDATE_STRIPE_CONNECT_SECRET=false

# Still needed by current Manus OAuth, file storage, AI vetting, owner notices.
# A new host does not automatically remove these dependencies.
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Separate, authorized sandbox API credential for the standalone operations tool.
# No webhook signing secret is needed by that tool. Never extract protected keys.
BOOGME_STRIPE_OPS_KEY=
