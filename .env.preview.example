# Copy to .env.preview only on the separately approved preview host.
# Start from an empty environment. Never copy a Manus production env export.
APP_ENV=preview
NODE_ENV=production
PREVIEW_INSTANCE_ID=coachqa
PORT=3000
VITE_APP_ID=boogme-preview-coachqa
VITE_FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-new-random-secret-of-at-least-32-characters
DATABASE_URL=mysql://preview_app:replace-me@127.0.0.1:3306/boogme_preview_coachqa
BACKGROUND_JOBS_ENABLED=false
AUTO_RELEASE_PAYOUTS_ENABLED=false
MANUS_DEV_TOOLS_ENABLED=false

# Mailpit HTTP send API. Private/local capture only; no SMTP relay or forwarding.
PREVIEW_MAIL_URL=http://127.0.0.1:8025

# A NEW, dedicated empty S3-compatible bucket. Browser origin can differ from
# internal service DNS. For remote storage use HTTPS on both origins.
PREVIEW_S3_ENDPOINT=https://s3.preview.example.com
PREVIEW_S3_PUBLIC_ENDPOINT=https://s3.preview.example.com
PREVIEW_S3_BUCKET=boogme-preview-coachqa
PREVIEW_S3_REGION=us-east-1
PREVIEW_S3_ACCESS_KEY_ID=replace-with-preview-only-access-key
PREVIEW_S3_SECRET_ACCESS_KEY=replace-with-preview-only-secret

# Leave absent/empty: Stripe, Resend, Manus Forge and Manus OAuth credentials.
# This phase uses native email/password login and makes no Stripe API calls.
# Set public VITE_* settings identically when BUILDING the client and RUNNING it.
